---
import Base from "../layouts/Base.astro";
import Aurora from "../components/Aurora.astro";
import RepoCard from "../components/RepoCard.astro";

// Descriptions are each package's own `package.json` `description`, verbatim.
const repos = [
  {
    name: "GMT",
    description:
      "Temporal-based date and time utilities with timezone support and polyfill integration",
    docsHref: "https://northguild.dev/gmt/",
    githubHref: "https://github.com/northguild/gmt",
  },
  {
    name: "worktree",
    description:
      "A CLI tool for managing git worktrees with enhanced workflow features",
    docsHref: "https://northguild.github.io/worktree/docs/getting-started",
    githubHref: "https://github.com/northguild/worktree",
  },
];
---

<Base title="NorthGuild">
  <Aurora />
  <h1 class="ng-enter-text">NorthGuild</h1>
  <p class="intro ng-enter-text">Open-source tools for developers, built in the frigid north.</p>
  <div class="grid">
    {repos.map((r, i) => <RepoCard {...r} order={i} />)}
  </div>
</Base>

<style>
  /* The sky only answers the pointer over bare page (Aurora.astro,
     `isBareSky`), so each block is only as wide as its own text, and the grid
     lets the pointer through its gaps to the sky behind. */
  h1,
  .intro {
    inline-size: fit-content;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin-top: 2rem;
    pointer-events: none;
  }
  .grid > :global(*) {
    pointer-events: auto;
  }

  /* The entrance (`.ng-enter-*`, Base.astro): the header leads, then the
     title, the line under it, and the cards in turn, landing as the sky's own
     fade-in (1.6s) finishes. */
  h1 {
    --ng-delay: 0.25s;
  }
  .intro {
    --ng-delay: 0.55s;
  }
  .grid > :global(*) {
    --ng-delay: calc(0.9s + var(--order, 0) * 0.25s);
  }
</style>
