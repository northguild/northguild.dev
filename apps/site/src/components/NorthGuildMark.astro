---
/**
 * The NorthGuild shield, drawn as frost on glass rather than flat fills.
 *
 * The shapes are the GMT docs mark (gmt `apps/dox/src/assets/northguild-logo.svg`):
 * the shield, its lit left half, the mountain field and the `</>`. Here it is
 * kept quiet to sit in the night sky: everything is the wordmark's ice tone at
 * low opacity, the panes are washes that fade out towards the point, and only
 * the shield's edge, the mountain ridge and the `</>` are drawn as lines.
 *
 * Inline, not an `<img>`, so the theme tokens reach every path. `aria-hidden`:
 * the wordmark beside it already reads "NorthGuild". The gradient ids are
 * fixed, so render this once per page.
 */
---

<svg
  class="ng-mark"
  viewBox="0 0 1000 1317"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="ng-mark-pane" x1="0" y1="0" x2="0" y2="1">
      <stop class="pane-top" offset="0"></stop>
      <stop class="pane-bottom" offset="1"></stop>
    </linearGradient>
    <linearGradient id="ng-mark-sheen" x1="0" y1="0" x2="1" y2="1">
      <stop class="sheen-top" offset="0"></stop>
      <stop class="sheen-bottom" offset="0.7"></stop>
    </linearGradient>
  </defs>
  <!-- Back to front: the panes of ice, then the lines drawn over them. -->
  <path
    class="pane"
    d="M500 0 L0 179.1 L0 709.1 C0 1018.6 373.1 1206.2 500 1317 C626.9 1206.2 1000 1018.6 1000 709.1 L1000 179.1 Z"
  ></path>
  <path
    class="sheen"
    d="M500 0 L0 179.1 L0 709.1 C0 1018.6 373.1 1206.2 500 1317 Z"></path>
  <path
    class="pane"
    d="M93.3 243.9 L500 99 L906.7 243.9 L906.7 686.5 L709.3 390.2 L654.9 470.3 L500 239.5 L345.1 470.3 L290.7 390.2 L93.3 686.5 Z"
  ></path>
  <path
    class="edge"
    d="M500 0 L0 179.1 L0 709.1 C0 1018.6 373.1 1206.2 500 1317 C626.9 1206.2 1000 1018.6 1000 709.1 L1000 179.1 Z"
  ></path>
  <path
    class="ridge"
    d="M93.3 686.5 L290.7 390.2 L345.1 470.3 L500 239.5 L654.9 470.3 L709.3 390.2 L906.7 686.5"
  ></path>
  <path
    class="glyph"
    d="M366 640 L212 736.5 L366 833 M634 640 L788 736.5 L634 833 M560 560 L443 910"
  ></path>
</svg>

<style>
  .ng-mark {
    display: block;
    block-size: 1.75rem;
    inline-size: auto;
    overflow: visible;
  }

  /* Faintly lighter at the top, clear at the point. */
  .pane-top {
    stop-color: var(--gmt-ice);
    stop-opacity: 0.07;
  }
  .pane-bottom {
    stop-color: var(--gmt-ice);
    stop-opacity: 0;
  }
  .sheen-top {
    stop-color: var(--gmt-ice);
    stop-opacity: 0.05;
  }
  .sheen-bottom {
    stop-color: var(--gmt-ice);
    stop-opacity: 0;
  }
  .pane {
    fill: url(#ng-mark-pane);
  }
  .sheen {
    fill: url(#ng-mark-sheen);
  }

  .edge,
  .ridge,
  .glyph {
    fill: none;
    stroke: var(--gmt-ice);
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* Hairlines stay one pixel at any size, like the borders around them. */
  .edge,
  .ridge {
    vector-effect: non-scaling-stroke;
    stroke-width: 1px;
  }
  .edge {
    stroke-opacity: 0.5;
  }
  .ridge {
    stroke-opacity: 0.35;
  }
  /* In viewBox units, so the glyph keeps its weight against the shield. */
  .glyph {
    stroke-opacity: 0.75;
    stroke-width: 36;
  }

  /* System colours: drop the washes, keep every line at full strength. */
  @media (forced-colors: active) {
    .ng-mark {
      forced-color-adjust: none;
    }
    .pane,
    .sheen {
      fill: none;
    }
    .edge,
    .ridge,
    .glyph {
      stroke: CanvasText;
      stroke-opacity: 1;
    }
  }
</style>
