---

<header class="gmt-glass site-header">
  <a class="wordmark" href="/">NorthGuild</a>
  <nav aria-label="NorthGuild community">
    {
      links.map((l) => (
        <a
          class="gmt-icon-button gmt-sonar-focus"
          href={l.href}
          aria-label={l.label}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d={l.path} />
          </svg>
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* A light frost: what is behind (stars, constellation lines) shows through
     softened instead of vanishing. */
  .site-header {
    --gmt-blur: 4px;
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 16px;
    border-radius: 0;
    border-width: 0 0 1px 0;
  }
  /* Only the bottom border: drop the glass panel's four-sided hairline and
     its top highlight. */
  .site-header::before,
  .site-header::after {
    display: none;
  }
  .wordmark {
    font-family: var(--gmt-font-display);
    color: var(--gmt-ice);
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .wordmark:focus-visible {
    outline: 2px solid var(--gmt-cyan);
    outline-offset: 4px;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  .gmt-icon-button {
    text-decoration: none;
  }
</style>
