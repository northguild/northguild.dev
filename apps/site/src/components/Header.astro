---
import NorthGuildMark from "./NorthGuildMark.astro";

interface Props {
  /** Plays the aurora entrance (`.ng-enter-pane`, Base.astro). */
  entrance?: boolean;
}
const { entrance = false } = Astro.props;

const links = [
  {
    label: "NorthGuild on GitHub",
    href: "https://github.com/northguild",
    path: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  },
  {
    label: "NorthGuild on Discord",
    href: "https://discord.gg/TdvQdP3t5a",
    path: "M20.32 4.37A19.8 19.8 0 0 0 15.4 2.85a.07.07 0 0 0-.08.04c-.21.38-.45.87-.61 1.26a18.3 18.3 0 0 0-5.42 0 12.6 12.6 0 0 0-.62-1.26.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.9 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.6.1 18.1a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.22-2a.08.08 0 0 0-.04-.1 13 13 0 0 1-1.87-.9.08.08 0 0 1 0-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.8 8.18 1.8 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.1c.36.7.77 1.37 1.22 2a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6.02-3.03.08.08 0 0 0 .03-.06c.5-5.2-.84-9.72-3.55-13.7a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.95-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.16-1.09-2.16-2.42s.95-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z",
  },
];
---

<header
  class:list={["gmt-glass", "site-header", { "ng-enter-pane": entrance }]}
  data-ng-target={entrance ? "header" : undefined}
>
  <div class="wordmark"><NorthGuildMark />NorthGuild</div>
  <div class="actions">
    <nav aria-label="NorthGuild community">
      {
        links.map((l) => (
          <a
            class="gmt-icon-button gmt-sonar-focus"
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${l.label} (opens in a new tab)`}
            title={l.label}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d={l.path} />
            </svg>
          </a>
        ))
      }
    </nav>
    {/* The Settings gear, last in the bar as on the GMT docs, and its panel:
        the mute button beside the volume fader. scripts/sound/control.ts
        wires them; Base.astro sets `data-sound` before first paint so the
        speaker is drawn right from the first frame. */}
    <button
      type="button"
      class="gmt-icon-button gmt-sonar-focus settings-button"
      popovertarget="ng-settings"
      aria-label="Settings"
      aria-expanded="false"
      title="Settings"
    >
      {/* Lucide's `settings` gear (ISC), filled, its view box cropped so it
          stands as tall as GitHub's mark; the hub is cut out by even-odd. */}
      <svg
        viewBox="1 1 22 22"
        fill="currentColor"
        fill-rule="evenodd"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915ZM15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z"
        ></path>
      </svg>
    </button>
    <div
      id="ng-settings"
      class="gmt-panel settings-panel"
      popover
      role="group"
      aria-label="Settings"
    >
      <div class="sound">
      <button
        type="button"
        id="ng-sound-mute"
        class="gmt-toggle-button mute"
        aria-label="Mute sound"
        aria-pressed="true"
        data-cue
      >
        <svg
          class="speaker"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"></path>
          <path data-slash d="M16 9.5l5 5M21 9.5l-5 5"></path>
          <path data-waves d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"></path>
        </svg>
      </button>
      <input
        type="range"
        id="ng-sound-fader"
        class="gmt-fader"
        min="1"
        max="11"
        step="1"
        value="5"
        aria-label="Volume"
        aria-valuetext="Volume 5 of 11, muted"
        style="--gmt-range-pct: 40"
      />
      </div>
    </div>
  </div>
</header>

<script>
  import { startCue } from "../scripts/sound/cue";
  import { mountSoundControl } from "../scripts/sound/control";

  mountSoundControl();
  startCue();
</script>

<style>
  /* A light frost: what is behind (stars, constellation lines) shows through
     softened instead of vanishing. */
  .site-header {
    --gmt-blur: 4px;
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 16px;
    border-radius: 0;
    border-width: 0 0 1px 0;
  }
  /* Only the bottom border: drop the glass panel's four-sided hairline and
     its top highlight. */
  .site-header::before,
  .site-header::after {
    display: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    /* Keeps the name close to the shield so they read as one mark. */
    gap: var(--gmt-space-3);
    font-family: var(--gmt-font-display);
    color: var(--gmt-ice);
    letter-spacing: 0.04em;
  }
  /* GitHub, Discord and the gear: one gap between all three, as on the docs. */
  .actions,
  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* The icons in the shield's quiet ice rather than the theme's cyan: grey
     at rest, ice on hover or focus, and the gear while its panel is open.
     The focus ring and its ping stay the theme's. */
  .gmt-icon-button {
    color: var(--gmt-ice-dim);
    text-decoration: none;
  }
  /* A button does not take the page's font size, and the icon buttons are
     sized in em: without this the gear is smaller than GitHub and Discord. */
  .settings-button {
    font: inherit;
  }
  .gmt-icon-button:hover,
  .gmt-icon-button:focus-visible,
  .settings-button:has(+ .settings-panel:popover-open) {
    color: var(--gmt-ice);
  }

  /* The panel: the speaker beside a fader that fills the rest, in the top
     layer under the gear, so opening it and dragging the fader move nothing
     in the bar. Fixed insets are the fallback where anchor positioning is
     missing: under the bar's right end. */
  .settings-panel {
    inline-size: min(16rem, calc(100vw - 2rem));
    inset: auto;
    inset-block-start: calc(3.5rem + 0.25rem);
    inset-inline-end: 16px;
  }
  /* The speaker beside the fader, in their own grid: the panel itself keeps
     its own display, so its layout holds while it fades out on close. */
  .sound {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }
  .mute {
    inline-size: 2rem;
    block-size: 2rem;
  }
  .mute svg {
    inline-size: 20px;
    block-size: 20px;
  }
  .settings-panel .gmt-fader {
    inline-size: 100%;
  }
  /* The speaker reads `data-sound` on <html>, set before first paint, so a
     muted visitor never sees it on. */
  :global(:root[data-sound="off"]) .speaker [data-waves],
  :global(:root:not([data-sound="off"])) .speaker [data-slash] {
    display: none;
  }

  @supports (position-area: bottom) {
    .settings-button {
      anchor-name: --ng-settings;
    }
    /* Right-aligned to the gear where it fits; on a narrow bar, where that
       would cross the 1rem gutter, centred under it instead. */
    .settings-panel {
      position-anchor: --ng-settings;
      position-area: bottom span-left;
      position-try-fallbacks: bottom;
      inset: auto;
      margin-block-start: 0.25rem;
      margin-inline-start: 1rem;
    }
  }
</style>
