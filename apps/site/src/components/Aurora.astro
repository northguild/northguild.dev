---
import {
  SITES,
  SKY_CREDITS,
  compass,
  coords,
} from "../scripts/aurora.sites";
// The installed @northguild/gmt's version, read at build time so the footer
// follows every upgrade. The package does not export its package.json, so
// it is read by path; only the version string reaches the page.
import { version as gmtVersion } from "../../node_modules/@northguild/gmt/package.json";
---

<div class="aurora" aria-hidden="true">
  <canvas></canvas>
</div>
<!-- The hovered star's constellation, traced out from it over the sky and
     under the page's cards. -->
<svg class="sky-lines" aria-hidden="true"></svg>

<!-- A faint info glyph, shown once the sky is running. It opens the details
     and credits for whichever site this visit drew. -->
<button
  class="sky-info-button gmt-icon-button gmt-sonar-focus"
  type="button"
  popovertarget="sky-info"
  aria-label="About this sky"
  hidden
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 11v5.5M12 7.75v.01"></path>
  </svg>
</button>
<!-- Names the sun, moon, planet or star under the pointer (or a tap). The
     popover covers the same for screen readers. -->
<div class="sky-tip gmt-glass-subtle" aria-hidden="true" hidden></div>
<div id="sky-info" class="sky-info gmt-glass" popover>
  <div class="sky-sites" role="group" aria-label="Seen from">
    {
      SITES.map((site, i) => (
        <button
          class="gmt-button gmt-sonar-focus"
          type="button"
          data-index={i}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {site.name}
        </button>
      ))
    }
  </div>
  {
    SITES.map((site, i) => (
      <section data-site={site.id} hidden={i !== 0}>
        <p class="place">
          {site.name}, {site.country}
        </p>
        <p>
          Looking {compass(site.heading)} from {site.spot}.{" "}
          {coords(site.lat, site.lon)}, eye height {site.eye}&nbsp;m.
        </p>
        <ul class="sky-times" aria-label="Sun and moon in this window">
          <li data-body="sun">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.25" fill="currentColor"></circle>
              <path
                d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <span class="body">Sun</span>
            <span class="when">Looking ahead…</span>
          </li>
          <li data-body="halo">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="13" r="2.6" fill="currentColor"></circle>
              <circle
                cx="12"
                cy="13"
                r="7.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-dasharray="3.2 1.6"
                opacity="0.8"></circle>
              <path
                d="M12 1.5v7.2"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <span class="body">Solar halo / pillar</span>
            <span class="when">Looking ahead…</span>
          </li>
          <li data-body="moon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle class="dark" cx="12" cy="12" r="8"></circle>
              <path class="lit" fill="currentColor"></path>
            </svg>
            <span class="body">Moon</span>
            <span class="when">Looking ahead…</span>
            <span class="phase"></span>
          </li>
          <li class="note">
            When each shows in this window, in your time zone<span class="zone"
            ></span>.
          </li>
        </ul>
        <p>
          It is always night here, but the stars, planets, moon and sun are
          where they really are right now, above the real {site.ground}. The
          aurora is simulated.
        </p>
        <dl>
          {site.credits.map(([what, source]) => (
            <>
              <dt>{what}</dt>
              <dd>{source}</dd>
            </>
          ))}
        </dl>
      </section>
    ))
  }
  <dl>
    {
      SKY_CREDITS.map(([what, source]) => (
        <>
          <dt>{what}</dt>
          <dd>{source}</dd>
        </>
      ))
    }
  </dl>
  <p class="sky-footer">
    Site runs on <a href="/gmt/">@northguild/gmt</a> v{gmtVersion}
  </p>
</div>

<script>
  import type { SiteTimes } from "../scripts/aurora.ahead";
  import type {
    AuroraMessage,
    SkyLabel,
    SkyLine,
    WorkerMessage,
  } from "../scripts/aurora.worker";

  // Order matches what the worker destructures.
  const TOKENS = [
    "--gmt-void",
    "--gmt-spring",
    "--gmt-cyan",
    "--gmt-teal",
    "--gmt-dst-purple",
    "--gmt-ice",
  ];

  // The visitor can switch site in the popover, which always shows the site
  // drawn. The last site they chose is kept in this browser and drawn again
  // on the next visit or reload; until they choose, the worker picks from the
  // browser's time zone (Finland: Helsinki, Iceland: Ísafjörður, else at
  // random) and reports it.
  const SITE_KEY = "northguild.sky.site";
  const sections = [
    ...document.querySelectorAll<HTMLElement>("#sky-info [data-site]"),
  ];
  const ids = sections.map((el) => el.dataset.site ?? "");
  // The index of the site kept in this browser, or -1 if none. Storage can be
  // blocked or throw (private windows, blocked site data).
  function storedSite(): number {
    try {
      return ids.indexOf(localStorage.getItem(SITE_KEY) ?? "");
    } catch {
      return -1;
    }
  }
  const chosen = storedSite();
  let site = Math.max(chosen, 0);
  const choices = [
    ...document.querySelectorAll<HTMLButtonElement>(".sky-sites button"),
  ];
  const show = () => {
    sections.forEach((el, i) => (el.hidden = i !== site));
    choices.forEach((button, i) =>
      button.setAttribute("aria-pressed", String(i === site)),
    );
  };
  show();
  const info = document.querySelector<HTMLButtonElement>(".sky-info-button");
  let post: ((message: AuroraMessage) => void) | null = null;

  // All WebGL runs in the worker. Without OffscreenCanvas the CSS gradient
  // stays, so the main thread never pays for the effect.
  const canvas = document.querySelector<HTMLCanvasElement>(".aurora canvas");
  if (canvas && "transferControlToOffscreen" in canvas) {
    const go = () => {
      const worker = new Worker(
        new URL("../scripts/aurora.worker.ts", import.meta.url),
        { type: "module" },
      );
      const send = (message: AuroraMessage, transfer: Transferable[] = []) =>
        worker.postMessage(message, transfer);
      post = send;
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const style = getComputedStyle(document.documentElement);
      const offscreen = canvas.transferControlToOffscreen();
      send(
        {
          type: "init",
          canvas: offscreen,
          width: canvas.clientWidth,
          height: canvas.clientHeight,
          colours: TOKENS.map((name) => style.getPropertyValue(name).trim()),
          site: chosen,
          still: motion.matches,
          hidden: document.hidden,
        },
        [offscreen],
      );
      worker.onmessage = ({ data }: MessageEvent<WorkerMessage>) => {
        if (typeof data === "object") {
          if ("pick" in data) {
            label(data.pick);
          } else if ("times" in data) {
            showTimes(data.times, data.zone);
          } else {
            site = data.site;
            show();
          }
          return;
        }
        const on = data === "on";
        if (!on) label(null);
        canvas.classList.toggle("on", on);
        if (info) info.hidden = !on;
      };
      motion.addEventListener("change", () =>
        send({ type: "still", still: motion.matches }),
      );
      document.addEventListener("visibilitychange", () =>
        send({ type: "hidden", hidden: document.hidden }),
      );
      let timer = 0;
      new ResizeObserver(() => {
        clearTimeout(timer);
        timer = window.setTimeout(
          () =>
            send({
              type: "size",
              width: canvas.clientWidth,
              height: canvas.clientHeight,
            }),
          150,
        );
      }).observe(canvas);
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(go, { timeout: 1500 });
    } else {
      setTimeout(go, 200);
    }
  }

  // Sun and moon times: the worker works them out while the popover is open
  // (and from a hover or focus on its button, for a head start).
  const R = 8;
  /** The moon's lit part for its age (0 new, π full), lit on the right while
   * waxing, as seen from the north. */
  const litPath = (age: number) => {
    const waxing = age < Math.PI;
    const crescent = Math.cos(age) > 0;
    const rx = (R * Math.abs(Math.cos(age))).toFixed(2);
    const limb = waxing ? 1 : 0;
    const terminator = waxing === crescent ? 0 : 1;
    return `M12 ${12 - R}A${R} ${R} 0 0 ${limb} 12 ${12 + R}A${rx} ${R} 0 0 ${terminator} 12 ${12 - R}Z`;
  };
  const showTimes = (all: SiteTimes[], zone: string) => {
    for (const el of document.querySelectorAll(".sky-times .zone")) {
      el.textContent = zone ? ` (${zone})` : "";
    }
    all.forEach((times, i) => {
      const section = sections[i];
      if (!section) return;
      for (const body of ["sun", "halo", "moon"] as const) {
        const row = section.querySelector(`[data-body="${body}"]`);
        const when = row?.querySelector(".when");
        if (!row || !when) continue;
        when.textContent = times[body].when;
        row.classList.toggle("now", times[body].now);
      }
      const moon = section.querySelector('[data-body="moon"]');
      moon?.querySelector(".phase")?.replaceChildren(times.moon.phase);
      moon?.querySelector(".lit")?.setAttribute("d", litPath(times.moon.age));
    });
  };
  const popover = document.querySelector<HTMLElement>("#sky-info");
  const want = (yes: boolean) => post?.({ type: "times", want: yes });
  popover?.addEventListener("toggle", (event) =>
    want((event as ToggleEvent).newState === "open"),
  );
  for (const type of ["pointerenter", "focus"]) {
    info?.addEventListener(type, () => want(true));
  }
  // Leaving the button without opening the popover stops the search. Focus
  // moving into the open popover keeps it.
  for (const type of ["pointerleave", "blur"]) {
    info?.addEventListener(type, () => {
      if (!popover?.matches(":popover-open")) want(false);
    });
  }

  // Tooltips: over bare sky the page asks the worker what is drawn under the
  // pointer (at most once a frame) and names it.
  const tip = document.querySelector<HTMLElement>(".sky-tip");
  let over = false;
  let asked: [number, number, number] | null = null;
  const bare = (target: EventTarget | null) =>
    target === document.documentElement ||
    target === document.body ||
    (target instanceof HTMLElement && target.tagName === "MAIN");

  // The tooltip rises into place out of a soft blur, and fades away. Timing
  // comes from the theme's enter tokens; reduced motion keeps only the fade.
  const root = getComputedStyle(document.documentElement);
  const enter = {
    duration: parseFloat(root.getPropertyValue("--gmt-enter-duration")) * 1000 || 500,
    easing: root.getPropertyValue("--gmt-enter-easing").trim() || "ease-out",
  };
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  let naming = "";
  let fade: Animation | null = null;
  const name = (found: SkyLabel | null) => {
    if (!tip) return;
    if (!found) {
      if (!naming) return;
      naming = "";
      const from = getComputedStyle(tip).opacity;
      fade?.cancel();
      fade = tip.animate([{ opacity: from }, { opacity: 0 }], {
        duration: 200,
        easing: "ease-in",
        fill: "forwards",
      });
      fade.onfinish = () => {
        if (!naming) tip.hidden = true;
      };
      return;
    }
    const fresh = found.name !== naming;
    if (fresh) {
      naming = found.name;
      tip.hidden = false;
      const note = document.createElement("span");
      note.textContent = found.note;
      tip.replaceChildren(found.name, ...(found.note ? [note] : []));
    }
    // Centred on the object, but kept inside the window at the sides.
    const half = tip.offsetWidth / 2 + 4;
    const width = document.documentElement.clientWidth;
    tip.style.left = `${Math.min(Math.max(found.x, half), width - half)}px`;
    tip.style.top = `${found.y}px`;
    tip.classList.toggle("below", found.y < 48);
    if (!fresh) return;
    const rise = tip.classList.contains("below") ? -6 : 6;
    fade?.cancel();
    fade = tip.animate(
      calm.matches
        ? [{ opacity: 0 }, { opacity: 1 }]
        : [
            {
              opacity: 0,
              transform: `translateY(${rise}px) scale(0.94)`,
              filter: "blur(4px)",
            },
            { opacity: 1, transform: "none", filter: "blur(0)" },
          ],
      enter,
    );
  };

  // Constellation lines: each run draws itself out from the hovered star, a
  // step at a time, and the whole figure fades away a moment after the
  // pointer leaves. Moving to another star of the same constellation keeps it,
  // and as the worker follows the star (resize, the sky turning) the lines
  // move with it without drawing again.
  const sketch = document.querySelector<SVGSVGElement>(".sky-lines");
  let figure = "";
  let wipe = 0;
  const polyline = ({ step, points }: SkyLine, drawn: boolean) => {
    const line = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "polyline",
    );
    line.setAttribute("points", points.join(" "));
    line.setAttribute("pathLength", "1");
    line.style.setProperty("--step", String(step));
    line.classList.toggle("drawn", drawn);
    return line;
  };
  const trace = (found: SkyLabel | null) => {
    if (!sketch) return;
    const next = (found?.lines && found.figure) || "";
    if (next === figure) {
      if (!next) return;
      clearTimeout(wipe);
      sketch.classList.remove("out");
      const lines = found?.lines ?? [];
      const old = [...sketch.children];
      lines.forEach((line, k) => {
        const el = old[k];
        if (el) el.setAttribute("points", line.points.join(" "));
        else sketch.append(polyline(line, true));
      });
      old.slice(lines.length).forEach((el) => el.remove());
      return;
    }
    if (!next) {
      sketch.classList.add("out");
      clearTimeout(wipe);
      wipe = window.setTimeout(() => {
        sketch.replaceChildren();
        figure = "";
      }, 1200);
      return;
    }
    clearTimeout(wipe);
    figure = next;
    sketch.classList.remove("out");
    sketch.replaceChildren(
      ...(found?.lines ?? []).map((line) => polyline(line, false)),
    );
  };

  // Once nothing is shown, the worker can stop following the last pick.
  let holding = false;
  const label = (found: SkyLabel | null) => {
    const shown =
      found && over && canvas?.classList.contains("on") ? found : null;
    if (holding && !shown) post?.({ type: "drop" });
    holding = !!shown;
    name(shown);
    trace(shown);
  };
  const point = (event: PointerEvent) => {
    over = bare(event.target);
    if (!over || !post) return label(null);
    const reach = event.pointerType === "mouse" ? 12 : 28;
    if (!asked) {
      requestAnimationFrame(() => {
        if (asked && over) {
          const [x, y, r] = asked;
          post?.({ type: "pick", x, y, reach: r });
        }
        asked = null;
      });
    }
    asked = [event.clientX, event.clientY, reach];
  };
  document.addEventListener(
    "pointermove",
    (event) => {
      if (event.pointerType !== "touch") point(event);
    },
    { passive: true },
  );
  document.addEventListener("pointerdown", point, { passive: true });
  // A touch pointer "leaves" as the finger lifts, right after the tap that
  // asked; its label stays until the next tap instead.
  document.documentElement.addEventListener("pointerleave", (event) => {
    if (event.pointerType === "touch") return;
    over = false;
    label(null);
  });

  // Switching site: fade the sky out, swap, and fade back in when the worker
  // reports the new frame is up.
  choices.forEach((button, i) =>
    button.addEventListener("click", () => {
      // Kept even when it is the site already drawn, which may have come
      // from the time zone or at random.
      try {
        localStorage.setItem(SITE_KEY, ids[i] ?? "");
      } catch {}
      if (i === site) return;
      site = i;
      show();
      label(null);
      if (!post || !canvas) return;
      canvas.classList.add("quick");
      canvas.classList.remove("on");
      window.setTimeout(() => post?.({ type: "site", site }), 400);
    }),
  );
</script>

<style>
  /* The gradient is the first paint and the fallback when WebGL is off,
     motion is reduced to a static frame, or the GPU cannot keep up. */
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    contain: strict;
    background:
      radial-gradient(
        120% 55% at 30% 0%,
        color(from var(--gmt-dst-purple) srgb r g b / 0.1),
        transparent 60%
      ),
      radial-gradient(
        90% 45% at 70% 18%,
        color(from var(--gmt-cyan) srgb r g b / 0.12),
        transparent 65%
      ),
      radial-gradient(
        110% 40% at 40% 40%,
        color(from var(--gmt-spring) srgb r g b / 0.06),
        transparent 70%
      ),
      var(--gmt-void);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--gmt-easing);
  }
  canvas.on {
    opacity: 1;
  }
  canvas.quick {
    transition-duration: 0.4s;
  }

  /* Barely there until hovered, focused or open. */
  .sky-info-button {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 5;
    font-size: 0.8rem;
    opacity: 0.35;
    transition: opacity var(--gmt-duration-fast) var(--gmt-easing);
  }
  .sky-info-button[hidden] {
    display: none;
  }
  .sky-info-button:hover,
  .sky-info-button:focus-visible,
  .sky-info-button:has(+ .sky-info:popover-open) {
    opacity: 1;
  }

  .sky-tip {
    position: fixed;
    z-index: 4;
    padding: 0.15rem 0.5rem;
    color: var(--gmt-ice);
    font-size: var(--gmt-text-xs);
    white-space: nowrap;
    pointer-events: none;
    translate: -50% calc(-100% - 12px);
  }
  .sky-tip :global(span) {
    color: var(--gmt-ice-dim);
  }
  .sky-tip :global(span)::before {
    content: " · ";
  }
  .sky-tip.below {
    translate: -50% 12px;
  }

  /* Under the cards, over the sky. Each polyline has pathLength 1, so a dash
     of 1 offset by 1 is the line not yet drawn. */
  .sky-lines {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(
      0 0 3px color(from var(--gmt-cyan) srgb r g b / 0.6)
    );
    transition: opacity var(--gmt-duration-med) var(--gmt-easing);
  }
  .sky-lines.out {
    opacity: 0;
    transition: opacity 0.7s var(--gmt-easing) 0.3s;
  }
  .sky-lines :global(polyline) {
    fill: none;
    stroke: color(from var(--gmt-ice) srgb r g b / 0.45);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: sky-trace 0.6s var(--gmt-enter-easing) forwards;
    animation-delay: calc(var(--step) * 0.16s);
  }
  /* Lines added while the figure is up, as a cut closes: already drawn. */
  .sky-lines :global(polyline.drawn) {
    animation: none;
    stroke-dashoffset: 0;
  }
  @keyframes sky-trace {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky-lines :global(polyline) {
      animation-delay: 0s;
    }
  }
  .sky-tip[hidden] {
    display: none;
  }

  .sky-info {
    position: fixed;
    inset: auto 12px 52px auto;
    margin: 0;
    width: min(22rem, calc(100vw - 24px));
    color: var(--gmt-ice-dim);
    font-size: var(--gmt-text-xs);
    line-height: 1.5;
  }
  .sky-info p {
    margin: 0 0 0.5rem;
  }
  /* Location switcher: a row of chips, the current one lit. */
  .sky-sites {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gmt-space-2);
    margin: 0 0 var(--gmt-space-3);
  }
  .sky-sites button {
    padding: 0.2rem 0.6rem;
    font-size: var(--gmt-text-xs);
  }
  .sky-sites button[aria-pressed="true"] {
    color: var(--gmt-cyan);
    border-color: var(--gmt-border-strong);
    background: var(--gmt-fill-strong);
  }
  .sky-info .place {
    color: var(--gmt-ice);
    font-size: var(--gmt-text-sm);
  }
  .sky-info dl {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.5rem;
  }
  .sky-info dl:last-child {
    margin-bottom: 0;
  }
  .sky-info dt {
    color: var(--gmt-ice);
  }
  .sky-info dd {
    margin: 0;
  }

  /* Sun and moon: icon, name, then when; the moon's phase on a line below.
     A body in view now is lit in cyan. */
  .sky-times {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    padding: 0.5rem 0;
    list-style: none;
    border-block: 1px solid var(--gmt-hairline);
  }
  /* The icon beside the name, and the times (and phase) under the name. */
  .sky-times li {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    column-gap: 0.5rem;
    align-items: start;
  }
  .sky-times .when {
    grid-column: 2;
  }
  .sky-times svg {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.05rem;
    color: var(--gmt-ice);
  }
  .sky-times .dark {
    fill: color(from var(--gmt-ice) srgb r g b / 0.08);
    stroke: color(from var(--gmt-ice) srgb r g b / 0.35);
    stroke-width: 1;
  }
  .sky-times .body {
    color: var(--gmt-ice);
  }
  .sky-times .phase {
    grid-column: 2;
  }
  .sky-times .phase:empty {
    display: none;
  }
  .sky-times li.now svg,
  .sky-times li.now .when {
    color: var(--gmt-cyan);
  }
  /* A quiet footer under the credits. */
  .sky-info .sky-footer {
    margin: 0.6rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--gmt-hairline);
  }
