---
import "@northguild/theme/tokens.css";
import "@northguild/theme/primitives.css";
import fontUrl from "@northguild/theme/fonts/michroma-latin-400-normal.woff2?url";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  /** Plays the aurora entrance on the header. The page's own blocks opt in
      with `.ng-enter-*`, so a page that sets this should stagger them after
      it. */
  entrance?: boolean;
}
const {
  title,
  description = "NorthGuild: open-source tools for developers.",
  entrance = false,
} = Astro.props;

// Social cards need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const ogAlt =
  "NorthGuild: open-source tools for developers, under the northern lights.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NorthGuild" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      entrance && import.meta.env.DEV && (
        <script is:inline>
          // Dev only: `?huginn=return` or `?huginn=first` picks the fly-in to
          // preview, whatever page came before, and `&from=/gmt/` (any path)
          // the page to come back from. Reload for a new flight. `?aurora=active`
          // or `?aurora=calm` holds the aurora in a surge or quiet.
          {
            const query = new URLSearchParams(location.search);
            const page = document.documentElement;
            page.dataset.huginn = query.get("huginn") || "";
            page.dataset.ngFrom = query.get("from") || "";
            page.dataset.aurora = query.get("aurora") || "";
          }
        </script>
      )
    }
    {
      entrance && (
        <script is:inline>
          "use strict";
          // Coming back from another of the site's pages (the GMT or worktree
          // docs), or by Back or Forward: the header is already up, so it
          // stays put and only the title, intro and cards come in again. A
          // fresh visit or a reload plays the whole entrance. The page came
          // back from is kept (`data-ng-from`) so Huginn can fly home from
          // its card's side; Back and Forward do not say which page that was.
          // In a block, so nothing here is left on the window.
          {
          // The path of the page this visit came back from, "" when that is
          // not known (Back or Forward), or null when it is not a return.
          function cameBackFrom() {
            try {
              const visit = performance.getEntriesByType("navigation")[0];
              if (visit && visit.type === "back_forward") return "";
              if (visit && visit.type !== "navigate") return null;
              const from = new URL(document.referrer);
              return from.origin === location.origin &&
                from.pathname !== location.pathname
                ? from.pathname
                : null;
            } catch {
              return null;
            }
          }
          const page = document.documentElement;
          const back = cameBackFrom();
          const flyIn =
            page.dataset.huginn || (back === null ? "first" : "return");
          if (flyIn === "return") page.classList.add("ng-return");
          if (back) page.dataset.ngFrom = back;
          // Huginn's fly-in paints the page in as he passes (Aurora.astro);
          // it waits for him, hidden. Only where the sky can run with motion,
          // and never for more than 4 s: if he has not reached the first box
          // by then, the usual entrance plays.
          if (
            !matchMedia("(prefers-reduced-motion: reduce)").matches &&
            "transferControlToOffscreen" in HTMLCanvasElement.prototype
          ) {
            page.classList.add("ng-await");
            setTimeout(function showIfHuginnIsLate() {
              if (!document.querySelector(".ng-brushed")) {
                page.classList.remove("ng-await");
              }
            }, 4000);
          }
          }
        </script>
      )
    }
  </head>
  <body>
    <Header entrance={entrance} />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--gmt-void);
    color: var(--gmt-ice);
    font-family: var(--gmt-font-mono);
    line-height: 1.6;
  }
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--gmt-space-6, 2rem) 16px;
  }
  h1,
  h2 {
    font-family: var(--gmt-font-display);
    font-weight: 400;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .intro {
    color: var(--gmt-ice-dim);
    max-width: 40rem;
  }
  a {
    color: var(--gmt-cyan);
  }
  /* ---- Entrance ----
   * Each block condenses out of the sky like a curtain of aurora drifting
   * across: a soft-edged band of light passes left to right, the blur clears
   * behind it, and the green-to-cyan tint it carries settles into the usual
   * ice. Nothing moves; it only comes into focus. `.ng-enter-text` is for type,
   * `.ng-enter-pane` for glass (it tints the border and glow instead). Set
   * `--ng-delay` to stagger.
   *
   * `backwards` only: once it ends every property falls back to the normal
   * style, so no filter or mask is left on the glass. The last keyframe is
   * that normal look, so there is no jump. */
  .ng-enter-text,
  .ng-enter-pane {
    --ng-aurora: color-mix(in oklab, var(--gmt-spring) 45%, var(--gmt-cyan));
    --ng-sweep: linear-gradient(100deg, #000 38%, transparent 62%);
    mask-size: 300% 100%;
    /* Let the blur and glow spill past the box instead of stopping at a hard
       edge: the mask repeats up and down and paints outside the box. */
    mask-repeat: repeat-y;
    mask-clip: no-clip;
    /* Longhands: the build's minifier turns this shorthand into
       `animation: none`. */
    animation-duration: 2.4s;
    animation-timing-function: cubic-bezier(0.25, 0.6, 0.2, 1);
    animation-fill-mode: backwards;
    animation-delay: var(--ng-delay, 0s);
  }
  .ng-enter-text {
    animation-name: ng-aurora-text;
  }
  .ng-enter-pane {
    animation-name: ng-aurora-pane;
  }

  /* The clear box-shadow is never seen. Chrome only paints a mask over the
     box and its shadows, so it gives the text's blur and glow room to fade
     out instead of stopping at the box's edge. */
  @keyframes ng-aurora-text {
    0% {
      mask-image: var(--ng-sweep);
      mask-position: 100% 0;
      filter: blur(12px);
      color: var(--ng-aurora);
      text-shadow: 0 0 24px color(from var(--ng-aurora) srgb r g b / 0.7);
      box-shadow: 0 0 48px 32px transparent;
    }
    45% {
      filter: blur(3px);
      color: var(--ng-aurora);
      text-shadow: 0 0 18px color(from var(--ng-aurora) srgb r g b / 0.45);
    }
    100% {
      mask-image: var(--ng-sweep);
      mask-position: 0% 0;
      filter: blur(0);
      text-shadow: 0 0 0 transparent;
      box-shadow: 0 0 48px 32px transparent;
    }
  }

  @keyframes ng-aurora-pane {
    0% {
      mask-image: var(--ng-sweep);
      mask-position: 100% 0;
      filter: blur(10px);
      border-color: color(from var(--ng-aurora) srgb r g b / 0.6);
      box-shadow: 0 0 40px -6px color(from var(--ng-aurora) srgb r g b / 0.4);
    }
    45% {
      filter: blur(2px);
      border-color: color(from var(--ng-aurora) srgb r g b / 0.4);
      box-shadow: 0 0 32px -6px color(from var(--ng-aurora) srgb r g b / 0.25);
    }
    100% {
      mask-image: var(--ng-sweep);
      mask-position: 0% 0;
      filter: blur(0);
    }
  }

  /* ---- Huginn's wake ----
   * On the home page the header, title, intro and cards wait, hidden, for
   * the fly-in
   * (`ng-await`, set in the head). As Huginn passes each one the page adds
   * `ng-brushed` with his heading: the same aurora light sweeps across it in
   * the direction he flies (`--ng-angle`, from `--ng-from` to `--ng-to`),
   * quickly (`--ng-brush-duration`), and the pane drifts a few pixels along
   * his line into place, as if his wings brushed it there.
   *
   * The mask is three times the pane's size, so the sweep's edge enters the
   * pane a quarter of the way through and leaves it at three quarters. */
  html.ng-await :is(.ng-enter-pane, .ng-enter-text):not(.ng-brushed) {
    animation-name: none;
    opacity: 0;
  }
  /* Coming back (`ng-return`, set in the head): the header is already up
     and stays as it is. The title, intro and cards come in again, by
     Huginn's homecoming or the usual entrance. */
  html.ng-return :is(.ng-enter-pane, .ng-enter-text)[data-ng-target="header"] {
    animation-name: none;
    opacity: 1;
  }
  :is(.ng-enter-pane, .ng-enter-text).ng-brushed {
    --ng-sweep: linear-gradient(
      var(--ng-angle, 135deg),
      #000 38%,
      transparent 62%
    );
    mask-size: 300% 300%;
    mask-repeat: no-repeat;
    animation-duration: var(--ng-brush-duration, 1s);
    animation-timing-function: linear;
    animation-delay: 0s;
  }
  .ng-enter-pane.ng-brushed {
    animation-name: ng-brush-pane;
  }
  .ng-enter-text.ng-brushed {
    animation-name: ng-brush-text;
  }
  @keyframes ng-brush-text {
    0% {
      mask-image: var(--ng-sweep);
      mask-position: var(--ng-from, 100% 100%);
      translate: calc(var(--ng-dx, 0.7) * -10px) calc(var(--ng-dy, 0.7) * -10px);
      filter: blur(12px);
      color: var(--ng-aurora);
      text-shadow: 0 0 24px color(from var(--ng-aurora) srgb r g b / 0.7);
      box-shadow: 0 0 48px 32px transparent;
    }
    45% {
      filter: blur(3px);
      color: var(--ng-aurora);
      text-shadow: 0 0 18px color(from var(--ng-aurora) srgb r g b / 0.45);
    }
    100% {
      mask-image: var(--ng-sweep);
      mask-position: var(--ng-to, 0% 0%);
      translate: 0 0;
      filter: blur(0);
      text-shadow: 0 0 0 transparent;
      box-shadow: 0 0 48px 32px transparent;
    }
  }
  @keyframes ng-brush-pane {
    0% {
      mask-image: var(--ng-sweep);
      mask-position: var(--ng-from, 100% 100%);
      translate: calc(var(--ng-dx, 0.7) * -10px) calc(var(--ng-dy, 0.7) * -10px);
      filter: blur(10px);
      border-color: color(from var(--ng-aurora) srgb r g b / 0.7);
      box-shadow: 0 0 44px -4px color(from var(--ng-aurora) srgb r g b / 0.5);
    }
    45% {
      filter: blur(2px);
      border-color: color(from var(--ng-aurora) srgb r g b / 0.45);
      box-shadow: 0 0 32px -6px color(from var(--ng-aurora) srgb r g b / 0.3);
    }
    100% {
      mask-image: var(--ng-sweep);
      mask-position: var(--ng-to, 0% 0%);
      translate: 0 0;
      filter: blur(0);
    }
  }

  /* Reduced motion: no drifting light or blur, just a short fade. */
  @media (prefers-reduced-motion: reduce) {
    .ng-enter-text,
    .ng-enter-pane {
      animation-name: ng-fade;
      animation-duration: 0.6s;
      animation-delay: 0s;
    }
  }
  @keyframes ng-fade {
    from {
      opacity: 0;
    }
  }
</style>
